#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
pdm run ruff check src tests && pdm run ruff format --check src tests && pdm run pyright || exit 1
# The fast Rust gates, only when Rust files are staged; bin/rust/check.sh runs everything, coverage included.
if git diff --cached --name-only | grep -q '^rust/'; then
  (cd rust && cargo fmt --check && cargo clippy --all-targets --all-features -q -- -D warnings) || exit 1
fi
